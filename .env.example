# Optional override for regenerated packaged docs. Defaults to ./game-source-readable/web,
# then ./game-source/web, inside this repo.
# GAME_SOURCE_DOC_SOURCE=./game-source-readable/web

# Optional local mod/report roots used by testing and profiling tools.
# MELVOR_MODS_ROOT=./mods
# MELVOR_REPORTS_DIR=./reports
# MELVOR_MOD_SOURCES_DIR=./mod-sources
# MELVOR_BROWSER_STORAGE_STATE=./.browser-state/melvor.json

# Optional Melvor Cloud credentials for browser automation tests.
# Use username, not email.
MELVOR_CLOUD_USERNAME=
MELVOR_CLOUD_PASSWORD=
MELVOR_CLOUD_TOTP_SECRET=
MELVOR_TEST_CHARACTER_SLOT=
