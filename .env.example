# Optional: by default the MCP uses ignored ./game-source as a standalone local source store.
# Set this only when you want to point tools at a separate git-backed source checkout.
# GAME_SOURCE_REPO=/path/to/game-source

# Optional alias supported by the MCP/search scripts.
# MELVOR_GAME_SOURCE_REPO=/path/to/game-source

# Optional local mod/report roots used by testing and profiling tools.
# MELVOR_MODS_ROOT=./mods
# MELVOR_REPORTS_DIR=./reports

# Optional Melvor Cloud credentials for browser automation tests.
# Use username, not email.
MELVOR_CLOUD_USERNAME=
MELVOR_CLOUD_PASSWORD=
MELVOR_CLOUD_TOTP_SECRET=
MELVOR_TEST_CHARACTER_SLOT=
